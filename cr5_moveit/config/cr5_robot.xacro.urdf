    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <origin xyz="-0.357 0 0.141" rpy="0 0 -1.5708" />
    <parent link="Link3" />
    <child link="Link4" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="50.0" velocity="1.0" />
  </joint>
  <link
    name="Link5">
    <inertial>
      <origin xyz="-3.7738E-07 -0.0045777 -0.0012971" rpy="0 0 0" />
      <mass value="0.7269" />
      <inertia
        ixx="0.00073069"
        ixy="-5.7806E-09"
        ixz="6.7132E-09"
        iyy="0.00071195"
