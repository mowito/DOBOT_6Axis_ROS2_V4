      <geometry>
        <mesh filename="package://dobot_rviz/meshes/cr5/Link2.dae" />
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 1.5708 0" />
    <parent link="Link1" />
    <child  link="Link2" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="50.0" velocity="1.0" />
  </joint>

  <link name="Link3">
    <inertial>
      <origin xyz="-0.15231 -1.4079E-07 0.022693" rpy="0 0 0" />
      <mass value="2.8536" />
      <inertia
        ixx="0.0032608"
        ixy="-3.2147E-10"
        ixz="0.00012363"
        iyy="0.0092967"
        iyz="2.9478E-10"
