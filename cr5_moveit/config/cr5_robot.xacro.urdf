    </visual>
    <collision>
      <origin xyz="0 0 0"  rpy="0 0 0" />
      <geometry>
        <mesh filename="package://dobot_rviz/meshes/cr5/Link3.dae" />
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="-0.427 0 0" rpy="0 0 0" />
    <parent link="Link2" />
    <child link="Link3" />
    <axis  xyz="0 0 1" />
    <limit lower="-2.86"  upper="2.86"  effort="50.0" velocity="1.0" />
  </joint>

  <link name="Link4">
    <inertial>
      <origin xyz="-3.2386E-07 -0.002077 -0.0015548" rpy="0 0 0" />
      <mass value="0.67058" />
      <inertia
        ixx="0.00066939"
        ixy="4.1975E-10"
        ixz="-1.0734E-08"
        iyy="0.00065424"
        iyz="0.00011081"
