<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="car">
    <static>false</static> <!-- Must be false for physics movement -->
    <link name="link">
      <inertial>
        <mass>1.0</mass> <!-- Adjust mass as needed -->
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://car/meshes/fiesta.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://car/meshes/fiesta.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

