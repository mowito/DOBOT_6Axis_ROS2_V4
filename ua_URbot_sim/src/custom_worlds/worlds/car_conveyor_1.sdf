<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="car_conveyor_world">

    <!-- Core systems (Fortress-style plugin names) -->
    <plugin
    filename="libignition-gazebo-physics-system"
    name="ignition::gazebo::systems::Physics"/>

    <plugin
    filename="libignition-gazebo-sensors-system"
    name="ignition::gazebo::systems::Sensors"/>

    <plugin
    filename="libignition-gazebo-scene-broadcaster-system"
    name="ignition::gazebo::systems::SceneBroadcaster"/>


    <!-- Simple inline ground plane (no model://ground_plane) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model> 

    <!-- Conveyor belt model -->
    <model name="conveyor">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>

    <link name="belt">
        <pose>0 0 0.15 0 0 0</pose>

        <visual name="belt_visual">
        <geometry>
            <box>
            <size>10 1.5 0.1</size>
            </box>
        </geometry>
        </visual>

        <collision name="belt_collision">
        <geometry>
            <box>
            <size>10 1.5 0.1</size>
            </box>
        </geometry>
        <surface>
            <friction>
            <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
            </ode>
            </friction>
        </surface>
        </collision>
    </link>

    <!-- TrackController system plugin -->
    <plugin
    filename="libignition-gazebo-track-controller-system.so"
    name="gz::sim::systems::TrackController">

    <!-- Must match the link name exactly -->
    <link>belt</link>

    <!-- Enable debug prints -->
    <debug>1</debug>

    <!-- GZ command topic for belt velocity -->
    <velocity_topic>/conveyor/track_cmd_vel</velocity_topic>

    <!-- Optional odometry topic -->
    <odometry_topic>/conveyor/odometry</odometry_topic>
    <odometry_publish_frequency>50</odometry_publish_frequency>

    <!-- Some limits -->
    <min_velocity>-2.0</min_velocity>
    <max_velocity> 2.0</max_velocity>
    </plugin>



    </model>

    <!-- Simple "car" box sitting on the conveyor near the left end -->
    <!-- We'll swap this for your DAE mesh after the world works. -->
    
    <model name="conveyor_car">
    <pose>-4.0 0 0.1 0 0 1.5708</pose>
    <static>false</static>

    <link name="chassis">
        <pose>0 0 0 0 0 0</pose>

        <visual name="car_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
            <mesh>
            <!-- Path to your DAE -->
            <uri>model://conveyor_car/meshes/car.dae</uri>

            <!-- Optional scaling (x y z). Tweak until it looks right -->
            <scale>0.8 0.8 0.8</scale>
            </mesh>
        </geometry>

        <!-- You can keep or remove material; many DAEs have their own -->
        <!-- <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
        </material> -->
        </visual>

        <collision name="car_collision">
        <geometry>
            <box>
            <size>1.5 0.8 0.5</size>
            </box>
        </geometry>
        </collision>

        <inertial>
        <mass>50</mass>
        <inertia>
            <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10</iyy><iyz>0</iyz>
            <izz>10</izz>
        </inertia>
        </inertial>
    </link>

    <!-- NEW: VelocityControl system -->
    <plugin
        filename="ignition-gazebo-velocity-control-system"
        name="ignition::gazebo::systems::VelocityControl">
        <!-- Optional: override topic; otherwise defaults to /model/conveyor_car/cmd_vel -->
        <topic>/model/conveyor_car/cmd_vel</topic>
        <!-- Optional initial velocity, e.g. start moving right away -->
        <!-- <initial_linear>1 0 0</initial_linear> -->
    </plugin>
    </model>


  </world>
</sdf>
