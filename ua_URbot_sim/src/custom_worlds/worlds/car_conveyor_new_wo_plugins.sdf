<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">

    <!-- Core world systems (Fortress / Ignition Gazebo 6) -->
    <plugin
      filename="libignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics"/>

    <!-- <plugin
      filename="libignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors"/>

    <plugin
      filename="libignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/> -->
    
    <plugin filename="ignition-gazebo-user-commands-system"
        name="ignition::gazebo::systems::UserCommands"/>

    <!-- Simple ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Conveyor belt model -->
    <model name="conveyor">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>

      <link name="belt">
        <!-- Center of belt is 0.15 m above world origin -->
        <pose>0 0 0.15 0 0 0</pose>

        <!-- Visual + collision are consistent -->
        <visual name="belt_visual">
          <geometry>
            <box>
              <size>10 1.0 0.1</size>
            </box>
          </geometry>
        </visual>

        <collision name="belt_collision">
          <geometry>
            <box>
              <size>10 1.0 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- TrackController system plugin -->
      <plugin
        filename="libignition-gazebo-track-controller-system.so"
        name="gz::sim::systems::TrackController">

        <!-- Must match the link name exactly -->
        <link>belt</link>

        <!-- Enable debug prints -->
        <debug>1</debug>

        <!-- GZ command topic for belt velocity -->
        <velocity_topic>/conveyor/track_cmd_vel</velocity_topic>

        <!-- Optional odometry topic -->
        <odometry_topic>/conveyor/odometry</odometry_topic>
        <odometry_publish_frequency>50</odometry_publish_frequency>

        <!-- Velocity limits -->
        <min_velocity>-2.0</min_velocity>
        <max_velocity> 2.0</max_velocity>
      </plugin>
    </model>

    <!-- Conveyor car -->
    <model name="conveyor_car">
      <!--
        Belt top:
          belt center z = 0.15
          half thickness = 0.1 / 2 = 0.05
          => top = 0.20

        Car collision box height = 0.5 => half height = 0.25
        If we spawn with model z = 0.50:
          car bottom = 0.50 - 0.25 = 0.25  (slightly above belt)
        Gravity will drop it onto the belt.
      -->
      <pose>-4.0 0 0.50 0 0 0</pose>
      <static>false</static>

      <link name="chassis">
        <!-- Physics frame aligned with world -->
        <pose>0 0 0 0 0 0</pose>

        <!-- Visual mesh, rotated so the car "faces right" -->
        <visual name="car_visual">
          <!-- Rotate mesh about Z by 90 deg -->
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>model://conveyor_car/meshes/car.dae</uri>
              <scale>0.8 0.8 0.8</scale>
            </mesh>
          </geometry>
        </visual>

        <!-- Collision used for physics / contact with belt -->
        <collision name="car_collision">
          <geometry>
            <box>
              <size>1.5 0.8 0.5</size>
            </box>
          </geometry>
        </collision>

        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10</iyy><iyz>0</iyz>
            <izz>10</izz>
          </inertia>
        </inertial>
      </link>

      <!-- VelocityControl system on the car -->
      <plugin
        filename="ignition-gazebo-velocity-control-system"
        name="ignition::gazebo::systems::VelocityControl">

        <!-- Default topic is /model/conveyor_car/cmd_vel, but we state it explicitly -->
        <topic>/model/conveyor_car/cmd_vel</topic>
      </plugin>
    </model>

  </world>
</sdf>
